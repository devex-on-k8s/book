{
	"name": "Appointments",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

	"runArgs": [
    "--network=host"
  ],

  "containerEnv": {
    "OLLAMA_HOST": "http://host.docker.internal:11434"
  },

	"features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "installDockerBuildx": false,
      "installDockerComposeSwitch": false,
      "moby": false
    }
  },

	"customizations": {
    "vscode": {
      "extensions": [
        // Go
        "golang.go",

        // YAML
        "redhat.vscode-yaml",

        // Excluding the Container extensions. Not needed + heavyweight.
        "-ms-azuretools.vscode-containers",
        "-ms-azuretools.vscode-docker"
      ]
    }
  },

  "mounts": [
    // Kubernetes config
    "source=${localEnv:HOME}/.kube,target=/home/devbox/.kube,type=bind"
  ],

  "forwardPorts": [
		8081
	],

  "portsAttributes": {
    "8081": {
      "label": "Appointments"
    }
  },

  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },

  "postCreateCommand": "echo 'alias podman=docker' >> ~/.bashrc && echo '127.0.0.1   localhost' | sudo tee /etc/hosts && go version",

	"remoteUser": "devbox",

  "waitFor": "postCreateCommand"
}
